# Скопируйте в .env и подставьте свои значения.
# Путь к файлу-хранилищу.
DATA_FILE=/data/inventory.xlsx
# Базовый URL для QR-кодов ящиков — адрес, доступный с телефона.
BASE_URL=
# Разрешённые CORS-источники фронтенда (через запятую).
CORS_ORIGINS=http://localhost:5173

# --- Публичный хост (для локальной разработки значения ниже не трогайте) ---
# Самостоятельная регистрация: open (локально) | closed — учётные записи
# создаёт администратор, первый — командой python -m app.bootstrap_admin <логин>.
REGISTRATION_MODE=open
# Флаг Secure у cookie сессии: включать при развёртывании по HTTPS.
SECURE_COOKIES=0
# Интерактивные доки /docs, /openapi.json (0 — отключить на публичном хосте).
DOCS_ENABLED=1
