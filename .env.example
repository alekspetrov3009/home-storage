# Скопируйте в .env и подставьте свои значения.
# Путь к файлу-хранилищу внутри контейнера (том монтируется в /data).
DATA_FILE=/data/inventory.xlsx
APP_TITLE=📦 Домашний склад
# Базовый URL для QR-кодов ящиков — адрес, доступный с телефона
# (например, http://192.168.1.50:8501 в домашней сети).
BASE_URL=http://localhost:8501