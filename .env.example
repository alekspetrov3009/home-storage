# «Домашний склад» — переменные docker compose.
# Скопируйте в .env и подставьте свои значения:  cp .env.example .env

# --- Публичный адрес (VPS) ---------------------------------------------------
# Домен, указывающий A-записью на IP сервера; Caddy выпустит сертификат
# Let's Encrypt автоматически (e-mail владельца не требуется). Локально
# оставьте пустым (localhost — самоподписанный сертификат, без обращения
# к Let's Encrypt).
DOMAIN=

# Публичный URL склада: подставляется в QR-коды ящиков и в проверку Origin.
BASE_URL=

# --- Порты на хосте -----------------------------------------------------------
# 80/443 — публичная точка входа (Caddy). WEB_PORT — диагностика nginx
# напрямую с сервера (127.0.0.1:WEB_PORT, наружу не торчит).
HTTP_PORT=80
HTTPS_PORT=443
WEB_PORT=8080

# --- Безопасность (продакшен) ---------------------------------------------------
# Самостоятельная регистрация: closed — учётные записи создаёт администратор,
# первый администратор создаётся командой
#   docker compose exec api python -m app.bootstrap_admin admin
REGISTRATION_MODE=closed
# Cookie сессии только по HTTPS (обязательно при DOMAIN с TLS).
SECURE_COOKIES=1
# Интерактивные доки API (/docs, /openapi.json) наружу не отдаются.
DOCS_ENABLED=0

# --- Сеть ----------------------------------------------------------------------
# Нужен только при обращении к API напрямую с другого origin (обычно пусто:
# браузер ходит на /api того же origin через Caddy → nginx).
CORS_ORIGINS=
