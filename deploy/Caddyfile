# Caddy — обратный прокси с автоматическим HTTPS (Let's Encrypt) для
# «Домашнего склада». Единственная точка входа: nginx (web) остаётся внутри
# compose-сети, наружу торчат только порты 80/443 этого контейнера.
#
# DOMAIN задаётся в .env рядом с docker-compose.yml; значение по умолчанию
# (localhost) получает внутренний самоподписанный сертификат — для локальной
# проверки, без обращения к Let's Encrypt. Для публичного домена сертификат
# Let's Encrypt выпускается автоматически (e-mail владельца не требуется).
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		# HSTS: браузер после первого ответа ходит только по HTTPS.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Не раскрывать веб-сервер в заголовках.
		-Server
	}

	reverse_proxy web:80
}
